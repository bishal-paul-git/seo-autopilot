{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bishal-paul-git/seo-autopilot/blob/main/schema/seo-autopilot.config.schema.json",
  "title": "seo-autopilot configuration",
  "type": "object",
  "required": [
    "sites"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stateDir": {
      "type": "string",
      "description": "Where reports and memory are kept (default .seo-autopilot)."
    },
    "dataDir": {
      "type": "string",
      "description": "Editable data files, playbooks and agents (default seo-autopilot)."
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "searchConsoleProperty",
          "sitemap"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://.*/$",
            "description": "Must start with https:// and end with a slash."
          },
          "searchConsoleProperty": {
            "type": "string",
            "description": "https://example.com/ (URL prefix) or sc-domain:example.com"
          },
          "sitemap": {
            "type": "string",
            "pattern": "^https://"
          },
          "ga4PropertyId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Numeric GA4 Property ID."
          },
          "inspectPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "indexNowPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "ignoreQueries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brandTerms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "indexNow": {
            "type": "object",
            "properties": {
              "keyEnv": {
                "type": "string"
              }
            }
          },
          "content": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "sitemap",
                  "json",
                  "markdown"
                ]
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dir": {
                "type": "string"
              },
              "urlPattern": {
                "type": "string"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "match": {
                      "type": "string"
                    },
                    "urlPattern": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "proposalsPerRun": {
                "type": "integer"
              },
              "topicsPerWeek": {
                "type": "integer"
              },
              "newsTopicsPerRun": {
                "type": "integer"
              },
              "pagesPerDay": {
                "type": "integer",
                "minimum": 1,
                "description": "Content-pace governor: most pages to release in one day (default 2)."
              },
              "pagesPerWeek": {
                "type": "integer",
                "minimum": 1,
                "description": "Most pages in any 7 days (default 8)."
              },
              "perTemplatePerDay": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "Most pages of one template (page type) in one day."
              }
            }
          },
          "review": {
            "type": "object",
            "description": "Sensitive-topic review gate (ymyl job).",
            "properties": {
              "topics": {
                "type": "object",
                "description": "Topic name to a list of keyword regex sources. Adds to or replaces the built-in topics; an empty list switches one off.",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "requireFields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Content fields a sensitive page must have (default author, reviewedBy)."
              }
            }
          },
          "citations": {
            "type": "object",
            "properties": {
              "market": {
                "type": "string",
                "description": "Default country for questions (default GB)."
              }
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "audit": {
            "type": "object",
            "properties": {
              "maxPages": {
                "type": "integer"
              }
            }
          },
          "geo": {
            "type": "object",
            "properties": {
              "pages": {
                "type": "integer"
              }
            }
          },
          "speed": {
            "type": "object",
            "properties": {
              "pages": {
                "type": "integer"
              }
            }
          },
          "ingest": {
            "type": [
              "object",
              "null"
            ]
          },
          "conversions": {
            "type": "object",
            "description": "Conversions check: the GA4 events this site should send (default [\"generate_lead\"]).",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "facts": {
            "type": "object",
            "description": "Facts guard. Default file: <dataDir>/verified-facts.json.",
            "properties": {
              "file": {
                "type": "string"
              },
              "strict": {
                "type": "boolean",
                "description": "Exit 1 when a claim is unverified, so a build or pull-request check blocks it."
              }
            }
          },
          "redirects": {
            "type": "object",
            "description": "Redirect map for the redirects job. Default file: <dataDir>/redirects.json (redirects-<id>.json when the config has several sites).",
            "properties": {
              "file": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": ["apache", "nginx", "netlify", "vercel"]
              },
              "output": {
                "type": "string",
                "description": "File the generated rules go into with --write, between seo-autopilot markers (for example public/.htaccess)."
              }
            }
          }
        }
      }
    }
  }
}
