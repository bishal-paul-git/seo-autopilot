{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bishal-paul-git/seo-autopilot/blob/main/schema/seo-autopilot.config.schema.json",
  "title": "seo-autopilot configuration",
  "type": "object",
  "required": [
    "sites"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stateDir": {
      "type": "string",
      "description": "Where reports and memory are kept (default .seo-autopilot)."
    },
    "dataDir": {
      "type": "string",
      "description": "Editable data files, playbooks and agents (default seo-autopilot)."
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "searchConsoleProperty",
          "sitemap"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://.*/$",
            "description": "Must start with https:// and end with a slash."
          },
          "searchConsoleProperty": {
            "type": "string",
            "description": "https://example.com/ (URL prefix) or sc-domain:example.com"
          },
          "sitemap": {
            "type": "string",
            "pattern": "^https://"
          },
          "ga4PropertyId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Numeric GA4 Property ID."
          },
          "inspectPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "indexNowPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "ignoreQueries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brandTerms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "indexNow": {
            "type": "object",
            "properties": {
              "keyEnv": {
                "type": "string"
              }
            }
          },
          "content": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "sitemap",
                  "json",
                  "markdown"
                ]
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dir": {
                "type": "string"
              },
              "urlPattern": {
                "type": "string"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "match": {
                      "type": "string"
                    },
                    "urlPattern": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "proposalsPerRun": {
                "type": "integer"
              },
              "topicsPerWeek": {
                "type": "integer"
              },
              "newsTopicsPerRun": {
                "type": "integer"
              }
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "audit": {
            "type": "object",
            "properties": {
              "maxPages": {
                "type": "integer"
              }
            }
          },
          "geo": {
            "type": "object",
            "properties": {
              "pages": {
                "type": "integer"
              }
            }
          },
          "speed": {
            "type": "object",
            "properties": {
              "pages": {
                "type": "integer"
              }
            }
          },
          "ingest": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
