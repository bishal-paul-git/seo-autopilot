    "./departments/ai-search/agents/seo-ai-visibility-tracker.md",
    "./departments/verticals/agents/seo-ecommerce.md",
    "./departments/verticals/agents/seo-local-agent.md",
    "./departments/quality/agents/seo-compliance-auditor.md",
    "./departments/quality/agents/seo-editor.md",
