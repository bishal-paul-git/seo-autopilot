{
  "name": "seo-autopilot",
  "description": "Open-source SEO autopilot for any website: Search Console reports, indexing checks, keyword research, news watching, weekly digests, approval-gated content drafting, drip scheduling and careful backlink help. Guided setup included.",
  "version": "2.1.0",
  "author": {
    "name": "Bishal Paul"
  },
